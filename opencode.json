{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["nice", "-n", "10", "npx", "chrome-devtools-mcp@latest", "--browserUrl", "http://127.0.0.1:9222"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["nice", "-n", "10", "npx", "@playwright/mcp@latest", "--headless", "--browser", "chromium"],
      "enabled": true
    }
  }
}
